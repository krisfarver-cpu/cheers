{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "indianabev": {
      "extends": "production",
      "environment": "production",
      "channel": "indianabev",
      "env": {
        "APP_VARIANT": "indianabev"
      }
    }
  },
  "submit": {
    "production": {},
    "indianabev": {}
  }
}
